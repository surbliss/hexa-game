cabal-version:      3.0
name:               hex-beers
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Thomas
maintainer:         thomas.dev@surlykke.dk
-- copyright:
category:           Game
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable hex-beers
    import:           warnings
    main-is:          Main.hs

    other-modules:
        Util, GenServer, Game.Logic, Game.Protocol, Game.Server, Game.Socket,
    -- other-extensions:
    build-depends:
        base ^>=4.20.2.0
        , containers
        , websockets
        , text
        , vector
    hs-source-dirs:   app
    default-language: GHC2024
